# Optional: turn on smart reading with an AI model hosted by NVIDIA.
# 1. Get a free key at https://build.nvidia.com (it starts with "nvapi-").
# 2. Copy this file to a new file called .env (no ".example") and paste your key below.
# Never share your key or commit .env: it is already in .gitignore.
NVIDIA_API_KEY=

# Which NVIDIA model reads the emails. Any chat model from build.nvidia.com works.
AI_MODEL=meta/llama-3.3-70b-instruct
